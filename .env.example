# Copy to .env and adjust values for your local environment.
# These values are consumed by docker-compose.yml and by the backend's
# Settings class (backend/app/core/config.py) as fallback defaults.

# --- Infrastructure (docker-compose) ---
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp
POSTGRES_DB=mcp_auditor
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Backend application ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://mcp:mcp@localhost:5432/mcp_auditor
REDIS_URL=redis://localhost:6379/0
# Fernet key used to encrypt MCPServer.connection_config at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Frontend (see frontend/.env.example for the file Next.js actually reads) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
