# Copy to .env for local development. Production secrets belong in files
# outside the repository; see docker-compose.prod.yml and README.md.

# --- Local infrastructure (docker-compose.yml) ---
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp
POSTGRES_DB=mcp_auditor
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=mcp

# --- Backend application ---
APP_ENV=development
LOG_LEVEL=INFO
OBSERVABILITY_LOG_LEVEL=INFO
API_KEY=
DATABASE_URL=postgresql+psycopg://mcp:mcp@localhost:5432/mcp_auditor
REDIS_URL=redis://:mcp@localhost:6379/0
ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:3000"]

# --- Container publishing and production image settings ---
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_IMAGE_TAG=local
NEXT_PUBLIC_API_URL=http://localhost:8000
CELERY_CONCURRENCY=2
# Absolute directory containing production secret files. Do not place this
# directory in the repository.
SECRETS_DIR=

# --- MCP execution policy ---
MCP_ALLOWED_LOCAL_COMMANDS=[]
MCP_SANDBOX_IMAGE=mcp-auditor-mcp-sandbox:latest
MCP_EXECUTION_MEMORY_LIMIT=256m
MCP_EXECUTION_CPU_LIMIT=1.0
MCP_EXECUTION_PIDS_LIMIT=64
MCP_EXECUTION_MAX_OUTPUT_BYTES=1048576

# --- Abuse protection ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_DISCOVERIES=10
RATE_LIMIT_AUDITS=5
RATE_LIMIT_REPORTS=30
MAX_ACTIVE_AUDITS_PER_SERVER=1
