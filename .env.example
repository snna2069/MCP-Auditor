# Copy to .env and adjust values for your local environment.
# These values are consumed by docker-compose.yml and by the backend's
# Settings class (backend/app/core/config.py) as fallback defaults.

# --- Infrastructure (docker-compose) ---
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp
POSTGRES_DB=mcp_auditor
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend application ---
APP_ENV=development
LOG_LEVEL=INFO
API_KEY=
DATABASE_URL=postgresql+psycopg://mcp:mcp@localhost:5432/mcp_auditor
REDIS_URL=redis://localhost:6379/0
# Fernet key used to encrypt MCPServer.connection_config at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Absolute paths of local MCP executables permitted for discovery.
MCP_ALLOWED_LOCAL_COMMANDS=[]

# Abuse protection. Limits are per client/API key in a fixed window.
# Defaults support normal dashboard polling while bounding expensive work.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_DISCOVERIES=10
RATE_LIMIT_AUDITS=5
RATE_LIMIT_REPORTS=30
MAX_ACTIVE_AUDITS_PER_SERVER=1

# --- Frontend (see frontend/.env.example for the file Next.js actually reads) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
